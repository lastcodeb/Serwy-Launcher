<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather (Open-Meteo) and speed test -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network card: ethernet vs Wi-Fi, Wi-Fi signal and link speed (no location needed) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Exact match-day alarms on Android 12+ (Android 11 needs nothing); falls back to inexact when denied -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- "Boşalt" button: ActivityManager.killBackgroundProcesses -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Last used app for the hero; granted via adb appops -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- "İzlemeye devam et": the system Watch Next list (normal protection level) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Runtime permission that lets TvProvider show other apps' rows; granted via adb -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- A launcher must see every installed app -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Neon">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Neon screensaver: started by the system only while the TV dreams. It must stay in the
             main process: on Android 11 the dream window (DreamActivity) is created in the
             package's main process and crashes if the service lives elsewhere. -->
        <service
            android:name=".dream.NeonDream"
            android:exported="true"
            android:label="Neon"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- WiZ sleep timer: woken by AlarmManager, does a few UDP sends and exits -->
        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <!-- Box language changed: restart so every label is rebuilt in the new language -->
        <receiver
            android:name=".i18n.LocaleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The remote's app buttons (YouTube, Netflix, Prime Video, TV+): see RemoteKeys -->
        <service
            android:name=".RemoteKeys"
            android:exported="true"
            android:label="Neon kumanda tuşları"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_keys" />
        </service>

        <!-- Only so the launcher may follow other apps' media sessions (now playing, play/pause);
             it reads no notifications. Allowed with cmd notification allow_listener. -->
        <service
            android:name=".data.MediaListener"
            android:exported="true"
            android:label="Neon müzik kontrolü"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Galatasaray match day: alarm-driven score polling and light effects -->
        <receiver
            android:name=".MatchReceiver"
            android:exported="false" />
    </application>
</manifest>
